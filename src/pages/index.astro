---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

const url = (path) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.replace(/^\/+/, "");
  return `${cleanBase}${cleanPath}`;
};
---

<Layout title="Inicio">
  <section class="home-visual-hero">
    <div class="hero-slider">
      <div class="hero-slide slide-one">
        <span>Foto principal del local / fachada</span>
      </div>
      <div class="hero-slide slide-two">
        <span>Foto con perros y gatos</span>
      </div>
      <div class="hero-slide slide-three">
        <span>Foto de atención en campo</span>
      </div>
    </div>

    <div class="hero-overlay"></div>

    <div class="home-visual-content">
      <div class="home-logo">
        <img src={url("uploads/mini_norte_logo_claro.png")} alt="Logo de Norte Agroveterinaria" />
      </div>

      <p class="eyebrow">Veterinaria urbana y rural</p>

      <h1 class="home-brand-title">
        <span class="home-brand-norte">NORTE</span>
        <span class="home-brand-agroveterinaria">AGROVETERINARIA</span>
      </h1>

      <p class="hero-text">
        Atención veterinaria para animales de compañía, visitas a campo y productos
        seleccionados para el cuidado diario de tus animales.
      </p>

      <div class="hero-actions">
        <a class="button" href={url("contacto")}>Contactanos</a>
        <a class="button button-secondary hero-secondary" href={url("servicios")}>
          Ver servicios
        </a>
      </div>
    </div>
  </section>

  <section class="home-quick-info">
    <article>
      <span>🐶</span>
      <strong>Animales de compañía</strong>
      <p>Atención para perros, gatos y otras mascotas.</p>
    </article>

    <article>
      <span>🐄</span>
      <strong>Animales de campo</strong>
      <p>Consultas rurales y visitas según disponibilidad.</p>
    </article>

    <article>
      <span>🦴</span>
      <strong>Productos</strong>
      <p>Medicamentos veterinarios para grandes y pequeños animales, accesorios, juguetes, higiene y más.</p>
    </article>
  </section>

  <section class="section split-section home-about-section">
    <div class="home-about-copy">
      <p class="eyebrow">Quiénes somos</p>

      <h2>Cuidado cercano para tus animales urbanos y rurales</h2>

      <p>
        En Norte Agroveterinaria combinamos experiencia, compromiso y cercanía
        para acompañarte tanto en la producción como en el cuidado de tus
        mascotas.
      </p>

      <p>
        Sabemos lo importante que es tu campo y trabajamos para que se
        desarrolle al máximo. También entendemos que tus mascotas son
        parte de tu familia, por lo que nos enfocamos en cuidar su salud
        y bienestar.
      </p>

      <div class="home-about-highlights" aria-label="Experiencia y áreas de trabajo">
        <div>
          <strong>Más de 20 años</strong>
          <span>de experiencia</span>
        </div>

        <div>
          <strong>Pasión por</strong>
          <span>el mundo agro</span>
        </div>

        <div>
          <strong>Enfoque en</strong>
          <span>el bienestar animal</span>
        </div>
      </div>
    </div>

    <div class="home-about-photo">
      <img
        src={url("uploads/fotos_decorativas/frente.jpeg")}
        alt="Equipo de Norte Agroveterinaria"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Servicios</p>
      <h2>Atención veterinaria urbana y rural</h2>
      <p>
        Una veterinaria pensada para acompañar distintas necesidades: desde controles
        clínicos de perros y gatos hasta consultas relacionadas con animales de campo
        y producción animal.
      </p>
    </div>

    <div class="home-services-grid">
      <article>
        <div class="icon-circle">🩺</div>
        <h3>Consulta general</h3>
        <p>Atención clínica, controles y orientación sanitaria.</p>
      </article>

      <article>
        <div class="icon-circle">💉</div>
        <h3>Vacunación y prevención</h3>
        <p>Seguimiento del cuidado preventivo de tus animales.</p>
      </article>

      <article>
        <div class="icon-circle">🌾</div>
        <h3>Visitas a campo</h3>
        <p>Consultas rurales y atención en contexto productivo.</p>
      </article>
    </div>

    <div class="center-action">
      <a class="button" href={url("servicios")}>Ver todos los servicios</a>
    </div>
  </section>

  <section class="section home-photo-strip">
    <div class="home-strip-photo strip-large photo-local">
      <img
        src={url("uploads/fotos_decorativas/interior_2.jpeg")}
        alt="Interior de Norte Agroveterinaria"
        loading="lazy"
      />
    </div>

    <div class="home-strip-photo strip-tall photo-campo">
      <img
        src={url("uploads/fotos_decorativas/gato_1.jpeg")}
        alt="Animales en el campo"
        loading="lazy"
      />
    </div>

    <div class="home-strip-photo strip-small photo-productos">
      <img
        src={url("uploads/fotos_decorativas/productos_garrapatas.png")}
        alt="Productos disponibles en Norte Agroveterinaria"
        loading="lazy"
      />
    </div>

    <div class="home-strip-photo strip-small photo-mascotas">
      <img
        src={url("uploads/fotos_decorativas/vacas_2.png")}
        alt="Mascotas de Norte Agroveterinaria"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section split-section reverse">
    <div>
      <p class="eyebrow">Productos</p>
      <h2>Productos para el cuidado diario</h2>
      <p>
        En nuestro catálogo podés encontrar productos para mascotas, animales de
        campo, y relacionados al cuidado del hogar. Cada producto se
        puede consultar directamente por WhatsApp.
      </p>

      <a class="button" href={url("productos")}>Ver productos</a>
    </div>

    <div class="catalog-preview">
      <div class="catalog-preview-card catalog-alimentos">
        <img
          src={url("uploads/fotos_decorativas/alimento_balanceado.avif")}
          alt="Alimentos para animales"
          loading="lazy"
        />
        <span>Alimentos</span>
      </div>

      <div class="catalog-preview-card catalog-accesorios">
        <img
          src={url("uploads/fotos_decorativas/gato_pechera.jpg")}
          alt="Accesorios para mascotas y animales"
          loading="lazy"
        />
        <span>Accesorios</span>
      </div>

      <div class="catalog-preview-card catalog-juguetes">
        <img
          src={url("uploads/fotos_decorativas/perro_pelota.jpg")}
          alt="Juguetes para mascotas"
          loading="lazy"
        />
        <span>Juguetes</span>
      </div>

      <div class="catalog-preview-card catalog-higiene">
        <img
          src={url("uploads/fotos_decorativas/perro_jabon.webp")}
          alt="Productos de higiene y cuidado animal"
          loading="lazy"
        />
        <span>Higiene</span>
      </div>
    </div>
  </section>

  <section class="section home-location-card">
    <div>
      <p class="eyebrow">Dónde estamos</p>
      <h2>En Resistencia, Chaco</h2>
      <p>
        Estamos en Benjamín Zorrilla 4235. Podés escribirnos por WhatsApp para
        consultar horarios, productos disponibles o coordinar una atención.
      </p>

      <div class="hero-actions">
        <a class="button" href={url("contacto")}>Ver contacto</a>
        <a
          class="button button-secondary"
          href="https://www.google.com/maps/place/Norte+Agroveterinaria/@-27.4053567,-58.9648337,1668m/data=!3m2!1e3!4b1!4m6!3m5!1s0x94450dd7687115ad:0x358ea368edac9b00!8m2!3d-27.4053615!4d-58.9622588!16s%2Fg%2F11z6727v9s?entry=ttu&g_ep=EgoyMDI2MDcyMi4wIKXMDSoASAFQAw%3D%3D"
          target="_blank"
        >
          Cómo llegar
        </a>
      </div>
    </div>

    <div class="map-embed">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4358.382213323981!2d-58.96483372367186!3d-27.40535671396935!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94450dd7687115ad%3A0x358ea368edac9b00!2sNorte%20Agroveterinaria!5e1!3m2!1sen!2sar!4v1779337402657!5m2!1sen!2sar"
        width="600"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </section>

  <section class="section contact-banner">
    <div>
      <p class="eyebrow">Norte Agroveterinaria</p>
      <h2>¿Querés hacer una consulta?</h2>
      <p>
        Escribinos por WhatsApp y contanos qué necesitás. Te orientamos según el caso.
      </p>
    </div>

    <a class="button" href="https://wa.me/5493624536625" target="_blank">
      Escribir por WhatsApp
    </a>
  </section>
</Layout>